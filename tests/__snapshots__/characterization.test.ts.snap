  "<p class="lbs-paragraph">&lt;div class=&quot;lbs-code-block&quot;&gt;<br>  &lt;div class=&quot;lbs-code-filename&quot;&gt;filename.js&lt;/div&gt;  &lt;!-- omitted if no filename --&gt;<br>  &lt;pre data-language=&quot;js&quot; data-filename=&quot;filename.js&quot;&gt;&lt;code&gt;…&lt;/code&gt;&lt;/pre&gt;<br>&lt;/div&gt;</p>",
